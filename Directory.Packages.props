<Project>
  <!-- Every package version is set here once; project files reference packages without a version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Haytham Launcher, Haytham Core and Gebinde must use the same Runtime version: they are published together. -->
    <PackageVersion Include="Haytham.Runtime" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
</Project>
